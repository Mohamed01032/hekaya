# Put ONE of these keys (or both). Leave both empty to run in offline mode
# (curated stories, label codes only, no photo recognition).
# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Gemini (free key): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
HEKAYA_PROVIDER=auto
HEKAYA_MODEL=claude-sonnet-5-5
HEKAYA_FAST_MODEL=claude-haiku-5-5
GEMINI_MODEL=gemini-flash-latest
GEMINI_FAST_MODEL=gemini-flash-latest
HEKAYA_CORS=*
HEKAYA_RATE_LIMIT=30
